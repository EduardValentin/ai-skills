{
  "version": 2,
  "adapter": "cat adapter.json",
  "record": "committed",
  "components": [
    { "name": "domain", "paths": ["src/domain/**"], "enforcement": "boundary-lint", "classify": [
        ["**/*-use-case.ts", "use-case"],
        ["**/*-repository.ts", "port"],
        ["clock.ts", "port"],
        ["index.ts", "barrel", { "ring": "entities" }],
        ["**", "entity"] ] },
    { "name": "adapters", "paths": ["src/adapters/**"], "enforcement": "boundary-lint", "classify": [["**", "adapter"]] },
    { "name": "web", "paths": ["src/web/**"], "entry": ["main.ts"], "enforcement": "boundary-lint", "classify": [
        ["main.ts", "composition-root"],
        ["**", "controller"] ] }
  ],
  "ports": [
    { "at": "src/domain/payroll-repository.ts#PayrollRepository", "owner": "domain", "humble": "adapters" },
    { "at": "src/domain/clock.ts#Clock", "owner": "domain" }
  ],
  "rules": { "R6": ["off", "one delivery mechanism; controllers call use cases directly"] }
}
