#!/usr/bin/env python3
import json
import sys
from pathlib import Path


WORKSPACE = Path(__file__).resolve().parent.parent
STATE_DIRECTORY = WORKSPACE / "qa-fixture-state"
STATE_PATH = STATE_DIRECTORY / "delivery-jobs.json"
INVOCATION_PATH = STATE_DIRECTORY / "tool-invocations.log"


def write_json(payload, *, stream=sys.stdout):
    print(json.dumps(payload, sort_keys=True), file=stream)


def load_state():
    if not STATE_PATH.exists():
        return {"jobs": {}}
    return json.loads(STATE_PATH.read_text(encoding="utf-8"))


def save_state(state):
    STATE_PATH.write_text(json.dumps(state, sort_keys=True) + "\n", encoding="utf-8")


def fail(message, exit_code):
    write_json({"error": message}, stream=sys.stderr)
    raise SystemExit(exit_code)


def main():
    STATE_DIRECTORY.mkdir(exist_ok=True)
    with INVOCATION_PATH.open("a", encoding="utf-8") as invocation_log:
        invocation_log.write("delivery-job " + " ".join(sys.argv[1:]) + "\n")

    if len(sys.argv) < 2:
        fail("usage: delivery-job reset|enqueue|run|status", 2)

    command = sys.argv[1]
    if command == "reset" and len(sys.argv) == 2:
        save_state({"jobs": {}})
        write_json({"reset": True})
        return

    state = load_state()
    jobs = state["jobs"]

    if command == "enqueue" and len(sys.argv) == 3:
        account_id = sys.argv[2]
        job_id = f"job-{account_id}"
        job = {
            "account_id": account_id,
            "deliveries": 0,
            "job_id": job_id,
            "status": "queued",
        }
        jobs[job_id] = job
        save_state(state)
        write_json(job)
        return

    if command in {"run", "status"} and len(sys.argv) == 3:
        job_id = sys.argv[2]
        if job_id not in jobs:
            fail(f"unknown job: {job_id}", 4)
        job = jobs[job_id]
        if command == "run":
            job["status"] = "completed"
            job["deliveries"] += 1
            save_state(state)
        write_json(job)
        return

    fail("usage: delivery-job reset|enqueue ACCOUNT|run JOB|status JOB", 2)


if __name__ == "__main__":
    main()
