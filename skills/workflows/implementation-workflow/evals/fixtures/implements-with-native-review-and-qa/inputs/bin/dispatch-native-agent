#!/bin/sh
set -eu

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
workspace=$(CDPATH= cd "$script_dir/.." && pwd)
state_dir="$workspace/implementation-fixture-state"
mkdir -p "$state_dir"

if [ "$#" -ne 2 ]; then
    printf '%s\n' 'usage: dispatch-native-agent ROLE HANDOFF_FILE' >&2
    exit 2
fi

role=$1
handoff=$2
case "$handoff" in
    /*) handoff_path=$handoff ;;
    *) handoff_path="$workspace/$handoff" ;;
esac
if [ ! -f "$handoff_path" ]; then
    printf 'handoff file not found: %s\n' "$handoff" >&2
    exit 2
fi
printf '%s|%s\n' "$role" "$handoff" >> "$state_dir/dispatches.log"

case "$role" in
    code-reviewer)
        PYTHONDONTWRITEBYTECODE=1 python3 - "$workspace" <<'PY'
import subprocess
import sys

workspace = sys.argv[1]
sys.path.insert(0, workspace)
from account_export import export_account

issues = []
records = [
    {
        "email": "owner@example.test",
        "display_name": "Example Owner",
        "internal_note": "fixture support note",
    }
]
expected = [{"email": "owner@example.test", "display_name": "Example Owner"}]
try:
    owner_result = export_account("acct-owner", "acct-owner", records)
except Exception as error:
    issues.append(f"owner export raised {type(error).__name__}: {error}")
else:
    if owner_result != expected:
        issues.append("owner export does not enforce the approved public-field boundary")

try:
    export_account("acct-intruder", "acct-owner", records)
except PermissionError as error:
    if str(error) != "account export denied":
        issues.append("denial error discloses identifiers or does not match the safe contract")
except Exception as error:
    issues.append(f"non-owner export raised {type(error).__name__}, not PermissionError")
else:
    issues.append("non-owner export is not denied")

tests = subprocess.run(
    [sys.executable, "-m", "unittest", "-v"],
    cwd=workspace,
    text=True,
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
    check=False,
)
if tests.returncode != 0:
    issues.append("the repository regression command fails")

if issues:
    print("REVIEW FINDINGS")
    for issue in issues:
        print(f"- [medium] {issue}")
else:
    print("REVIEW CLEAN")
    print("- authorization, public-field filtering, safe error text, and tests verified")
PY
        ;;
    qa-verifier)
        PYTHONDONTWRITEBYTECODE=1 python3 - "$workspace" <<'PY'
import json
import subprocess
import sys

workspace = sys.argv[1]


def run(*arguments):
    return subprocess.run(
        [sys.executable, "export_cli.py", *arguments],
        cwd=workspace,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


owner = run("--requester", "acct-owner", "--owner", "acct-owner")
try:
    owner_payload = json.loads(owner.stdout) if owner.stdout else None
except json.JSONDecodeError:
    owner_payload = None
expected = [{"email": "owner@example.test", "display_name": "Example Owner"}]
ac1 = owner.returncode == 0 and owner_payload == expected and owner.stderr == ""

denied = run("--requester", "acct-intruder", "--owner", "acct-owner")
ac2 = (
    denied.returncode == 3
    and denied.stdout == ""
    and denied.stderr == "account export denied\n"
)

print(f"AC-1 {'PASS' if ac1 else 'FAIL'}: owner CLI export and public fields")
print(f"AC-2 {'PASS' if ac2 else 'FAIL'}: non-owner CLI denial and safe error")
print("QA PASS" if ac1 and ac2 else "QA FAIL")
PY
        ;;
    *)
        printf 'unknown native agent role: %s\n' "$role" >&2
        exit 2
        ;;
esac
