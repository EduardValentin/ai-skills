#!/bin/sh
set -eu

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
workspace=$(CDPATH= cd "$script_dir/.." && pwd)
state_dir="$workspace/implementation-fixture-state"
mkdir -p "$state_dir"

if [ "$#" -ne 2 ]; then
    printf '%s\n' 'usage: dispatch-generic-agent ROLE HANDOFF_FILE' >&2
    exit 2
fi

role=$1
handoff=$2
case "$handoff" in
    /*) handoff_path=$handoff ;;
    *) handoff_path="$workspace/$handoff" ;;
esac
if [ ! -f "$handoff_path" ]; then
    printf 'handoff file not found: %s\n' "$handoff" >&2
    exit 2
fi
printf '%s|%s\n' "$role" "$handoff" >> "$state_dir/dispatches.log"

case "$role" in
    independent-reviewer)
        PYTHONDONTWRITEBYTECODE=1 python3 - "$workspace" <<'PY'
import subprocess
import sys

workspace = sys.argv[1]
tests = subprocess.run(
    [sys.executable, "-m", "unittest", "-v"],
    cwd=workspace,
    text=True,
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
    check=False,
)
if tests.returncode == 0:
    print("REVIEW CLEAN")
    print("- role boundary, ordering, CLI integration, and regression coverage verified")
else:
    print("REVIEW FINDINGS")
    print("- [high] repository regression command fails")
    print(tests.stdout)
PY
        ;;
    runtime-qa)
        PYTHONDONTWRITEBYTECODE=1 python3 - "$workspace" <<'PY'
import json
import subprocess
import sys

workspace = sys.argv[1]


def run(role):
    return subprocess.run(
        [sys.executable, "feature_flags_cli.py", "--role", role],
        cwd=workspace,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


operator = run("operator")
admin = run("admin")
try:
    operator_payload = json.loads(operator.stdout)
    admin_payload = json.loads(admin.stdout)
except json.JSONDecodeError:
    operator_payload = None
    admin_payload = None

ac1 = operator.returncode == 0 and operator_payload == ["search-v2"]
ac2 = admin.returncode == 0 and admin_payload == [
    "billing-console",
    "search-v2",
    "staged-import",
]
print(f"AC-1 {'PASS' if ac1 else 'FAIL'}: operator CLI visibility")
print(f"AC-2 {'PASS' if ac2 else 'FAIL'}: admin CLI visibility")
print("QA PASS" if ac1 and ac2 else "QA FAIL")
PY
        ;;
    *)
        printf 'unknown generic agent role: %s\n' "$role" >&2
        exit 2
        ;;
esac
