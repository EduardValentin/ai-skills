#!/bin/sh
set -eu

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
workspace=$(CDPATH= cd "$script_dir/.." && pwd)
printf 'gh %s\n' "$*" >> "$workspace/tool-invocations.log"

case " $* " in
  *" --help "*|*" help "*)
    printf '%s\n' 'Fake gh supports: pr view, pr checks, and api reads.'
    ;;
  *" pr checks "*)
    cat <<'JSON'
[{"name":"build","required":true,"status":"COMPLETED","conclusion":"SUCCESS"},{"name":"surface-tests-checkout","required":true,"status":"COMPLETED","conclusion":"SUCCESS"}]
JSON
    ;;
  *" pr view "*|*" api "*)
    cat <<'JSON'
{"number":77,"url":"https://github.example/acme/app/pull/77","state":"OPEN","isDraft":false,"baseRefName":"main","headRefName":"app-77-checkout","mergeStateStatus":"CLEAN","body":"Tracks APP-77","linkedTickets":["APP-77"],"repositoryPolicy":{"requiredApprovals":1,"codeOwnerReviewRequired":false,"requiredChecks":["build","surface-tests-checkout"]},"reviewDecision":"APPROVED","approvals":[{"reviewer":"fixture-reviewer","state":"APPROVED"}],"requestedChangesReviews":0,"unresolvedReviewThreads":0,"statusCheckRollup":[{"name":"build","required":true,"status":"COMPLETED","conclusion":"SUCCESS"},{"name":"surface-tests-checkout","required":true,"status":"COMPLETED","conclusion":"SUCCESS"}],"implementedSurfaceTests":{"checkout-flow":"PASS"}}
JSON
    ;;
  *)
    printf '%s\n' 'Unsupported fake gh invocation. Run gh --help.' >&2
    exit 2
    ;;
esac
