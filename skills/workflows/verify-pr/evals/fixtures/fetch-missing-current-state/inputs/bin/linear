#!/bin/sh
set -eu

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
workspace=$(CDPATH= cd "$script_dir/.." && pwd)
printf 'linear %s\n' "$*" >> "$workspace/tool-invocations.log"

case " $* " in
  *" --help "*|*" help "*)
    printf '%s\n' 'Fake linear supports issue and search reads.'
    ;;
  *)
    cat <<'JSON'
{"identifier":"APP-77","title":"Checkout resilience","status":{"name":"In Review","type":"started"},"projectPolicy":{"reviewStates":["In Review","Ready for Merge"]},"url":"https://linear.example/acme/issue/APP-77"}
JSON
    ;;
esac
