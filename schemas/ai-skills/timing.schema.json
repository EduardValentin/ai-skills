{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-skills/timing.schema.json",
  "title": "AI Skills evaluation timing record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_id",
    "run_id",
    "skill_name",
    "case_id",
    "run_kind",
    "harness",
    "model",
    "reasoning_effort",
    "started_at",
    "ended_at",
    "duration_ms",
    "total_tokens",
    "status",
    "exit_code",
    "token_details",
    "execution_binding",
    "successful_skill_reads",
    "expected_skill_path"
  ],
  "properties": {
    "schema_version": {"const": "ai-skills.eval.timing.v1"},
    "invocation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "run_id": {"type": "string", "minLength": 1},
    "skill_name": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "run_kind": {"type": "string", "minLength": 1},
    "harness": {"type": "string", "minLength": 1},
    "model": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Exact model configuration passed in the bound harness request; not independent backend-routing attestation."
    },
    "reasoning_effort": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Exact reasoning configuration passed in the bound harness request; not independent backend-routing attestation."
    },
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "status": {"enum": ["completed", "failed", "timeout"]},
    "exit_code": {"type": ["integer", "null"]},
    "execution_binding": {
      "oneOf": [
        {"$ref": "#/$defs/execution_binding"},
        {"type": "null"}
      ]
    },
    "successful_skill_reads": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_skill_path": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "token_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cached", "source"],
      "properties": {
        "input": {"type": ["integer", "null"], "minimum": 0},
        "output": {"type": ["integer", "null"], "minimum": 0},
        "cached": {"type": ["integer", "null"], "minimum": 0},
        "source": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "execution_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "run_id",
        "role",
        "request_sha256",
        "binding_sha256"
      ],
      "properties": {
        "invocation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "run_id": {"type": "string", "minLength": 1},
        "role": {"const": "actor"},
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
