{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-skills/attempt.schema.json",
  "title": "AI Skills evaluation attempt declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "skill_name",
    "case_id",
    "run_kind",
    "aggregation"
  ],
  "properties": {
    "schema_version": {"const": "ai-skills.eval.attempt.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "skill_name": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "run_kind": {"type": "string", "minLength": 1},
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "variant",
        "contributes_to_outcome",
        "required_variants"
      ],
      "properties": {
        "group_id": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "contributes_to_outcome": {"type": "boolean"},
        "required_variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "compare_to": {"type": "string", "minLength": 1},
        "minimum_pass_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "configured_runs": {"type": "integer", "minimum": 1},
        "run_number": {"type": "integer", "minimum": 1}
      },
      "dependentRequired": {
        "minimum_pass_rate": ["configured_runs", "run_number"],
        "configured_runs": ["minimum_pass_rate", "run_number"],
        "run_number": ["minimum_pass_rate", "configured_runs"]
      }
    }
  }
}
